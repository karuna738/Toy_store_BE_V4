# ==============================================================================
# ToyVerse Backend Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure with your local credentials
# NEVER COMMIT PASSWORDS OR REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# JWT Security
# Generate a random 64-char hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=toyverse_db
DB_CONNECTION_LIMIT=10

# Initial Admin Account Seed Configuration
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@toyverse.demo
ADMIN_PASSWORD=admin123
ADMIN_PHONE=9000000001
ADMIN_ADDRESS=ToyVerse HQ, Anna Salai, Chennai 600002

# Business Rules
LOW_STOCK_LIMIT=5
FREE_DELIVERY_THRESHOLD=999
DELIVERY_FEE=49

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20
